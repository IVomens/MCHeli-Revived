[Handling]
;HandlingAssistedHeli = true: helicopters level pitch and roll by themselves while the stick is centred, and hold their altitude once the throttle keys are let go. false = as always.
HandlingAssistedHeli = false
;HandlingAutoRudderPlane = true: planes in the air yaw towards their bank (coordinated turns).
HandlingAutoRudderPlane = false
;HandlingAutoRudderGain = rudder at a 90 degree bank, as a share of full stick, 0 to 2.
HandlingAutoRudderGain = 0.50
;HandlingStickSmoothingHeli = seconds the helicopter stick takes to follow the mouse (time constant, 0 to 0.5). 0 = off.
HandlingStickSmoothingHeli = 0.00
;HandlingStickSmoothingPlane = the same for planes. 0 = off.
HandlingStickSmoothingPlane = 0.00
;HandlingStickCentringHeli = how fast the helicopter mouse stick returns to the centre when the mouse rests, per second (0 to 10). 0 = off.
HandlingStickCentringHeli = 0.00
;HandlingStickCentringPlane = the same for planes. 0 = off.
HandlingStickCentringPlane = 0.00
;HandlingKeyPitchRate, HandlingKeyRollRate, HandlingKeyYawRate = turn rate of the stick keys below, degrees per second at full ramp (limited by the vehicle's own rates).
HandlingKeyPitchRate = 30.00
HandlingKeyRollRate = 40.00
HandlingKeyYawRate = 20.00
;HandlingKeyRampTime = seconds a stick key takes to reach its full rate (0 to 2).
HandlingKeyRampTime = 0.30
;KeyStickPitchUp ... KeyStickYawRight = keys that move the stick like the mouse does. 0 = unbound (default).
KeyStickPitchUp = 0
KeyStickPitchDown = 0
KeyStickRollLeft = 0
KeyStickRollRight = 0
KeyStickYawLeft = 0
KeyStickYawRight = 0


[Joystick]
;JoystickEnabled = true reads a joystick or gamepad for flying. While it is connected it drives the axes it is bound to instead of the mouse. false (default) = no joystick is read.
JoystickEnabled = false
;JoystickDevice = empty for the first connected device, otherwise part of its name or its GUID.
JoystickDevice = 
;JoystickUseGamepadMapping = true reads known gamepads in the standard layout (axes: left x 0, left y 1, right x 2, right y 3, triggers 4 and 5).
JoystickUseGamepadMapping = true
;Joystick<Pitch|Roll|Yaw|Throttle>Axis = the axis number, -1 for none; Joystick<...>Invert = true flips it.
JoystickPitchAxis = 1
JoystickPitchInvert = false
JoystickRollAxis = 0
JoystickRollInvert = false
JoystickYawAxis = 2
JoystickYawInvert = false
JoystickThrottleAxis = 3
JoystickThrottleInvert = false
;JoystickThrottleMode = incremental (a centring stick moves the throttle up and down) or absolute (a throttle lever; forward is full).
JoystickThrottleMode = incremental
;JoystickThrottleRate = throttle per second at full incremental deflection.
JoystickThrottleRate = 0.50
;JoystickDeadZone, JoystickExpo, JoystickSensitivity = the response of the stick axes: dead zone 0 to 0.9, expo 0 (linear) to 1 (cubic), sensitivity 0.1 to 3.
JoystickDeadZone = 0.10
JoystickExpo = 0.30
JoystickSensitivity = 1.00
;JoystickButton<Action> = the button that does what the action's key does, -1 for none. The defaults suit a gamepad.
JoystickButtonFire = 5
JoystickButtonNextWeapon = 3
JoystickButtonWeaponMode = 14
JoystickButtonReload = 11
JoystickButtonFlare = 1
JoystickButtonChaff = 12
JoystickButtonGear = 2
JoystickButtonCameraMode = 13
JoystickButtonZoom = 10
JoystickButtonFreeLook = 9
JoystickButtonHover = 0
JoystickButtonExtra = 4
JoystickButtonThrottleUp = -1
JoystickButtonThrottleDown = -1
