{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.exampleaddon.fabric.AddonFabric"
    ],
    "fabric-gametest": [
      "com.example.exampleaddon.fabric.AddonFabricGameTests"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21",
    "mcheli": "${mcheli_fabric_version_range}"
  }
}
